{
  "name": "sunaba-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile ../bin/sunaba-ui",
